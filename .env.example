# Herbal Store MVP — konfiguratsiya namunasi (REAL SECRET EMAS)
# Ushbu fayl commit qilinadi; haqiqiy .env faylini hech qachon Git'ga qo‘shmang.
# Variable nomlari Django va Compose bilan bir xil.
# Quyidagi qiymatlar faqat lokal muhit uchun SHABLON; productionga aynan ko‘chirmang.

COMPOSE_PROJECT_NAME=herbal_store_mvp_dev

# Django
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_FOR_EACH_ENVIRONMENT
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.178.150.236
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://10.178.150.236:8080
DJANGO_TIME_ZONE=Asia/Tashkent

# PostgreSQL (Compose ichidagi service nomi: db)
POSTGRES_DB=herbal_store
POSTGRES_USER=herbal_store
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT token muddati (arxitektura bo‘yicha tavsiya)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Nginx localhost va aniq Wi-Fi IPga publish qilinadi; DB/backend host porti yo‘q.
WEB_HTTP_PORT=8080
# Joriy lokal Wi-Fi IPv4. DHCP IP o‘zgarsa ushbu qiymat va yuqoridagi hosts/originsni moslang.
WEB_LAN_IP=10.178.150.236
